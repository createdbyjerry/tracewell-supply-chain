        "faint": "#736D86",
        "chip": "#2A2638",
        "dot": "#2C2839",
        "edge-dim": "#3A3550",
        "label-bg": "#ECEAF3",
        "label-fg": "#13111A",
        "mask": "rgba(19, 17, 26, 0.72)"
      },
      "shadow": {
        "shadow": "0 2px 4px rgba(0,0,0,0.3)",
        "glow": "0 0 16px rgba(158,116,255,0.35)",
        "float": "0 20px 44px -12px rgba(0, 0, 0, 0.7), 0 4px 12px -2px rgba(0, 0, 0, 0.45)"
