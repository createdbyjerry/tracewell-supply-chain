    "label-fg": "Edge label text",
    "mask": "Overlay behind sheets",
    "shadow": "Card shadow",
    "glow": "Selected-node glow",
    "float": "Drop shadow for floating containers (app bar, side panel, canvas controls)",
    "radius-sm": "Small controls, chips, status badges",
    "radius-md": "Graph nodes, buttons, list rows",
    "radius-lg": "Cards inside panels, zoom controls, minimap",
