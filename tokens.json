{
  "$description": "Single source of truth for Tracewell design tokens. Edit this file, then run `node scripts/build-tokens.mjs` (GitHub Actions does it for you on push). Each token becomes a CSS variable named --{prefix}-{name}.",
  "prefix": "twsc",
  "shared": {
    "font": {
      "value": "\"Montserrat\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "description": "Font stack for all text"
    }
  },
  "themes": {
    "light": {
      "color": {
        "bg": "#F9F9FB",
        "surface": "#FFFFFF",
        "surface-2": "#F7FAFC",
        "primary": "#581BD3",
        "primary-soft": "rgba(88, 27, 211, 0.08)",
        "primary-line": "rgba(88, 27, 211, 0.2)",
        "border": "#E2E8F0",
        "text": "#1A202C",
        "text-2": "#4A5568",
        "muted": "#718096",
        "faint": "#A0AEC0",
        "chip": "#EDF2F7",
        "dot": "#D9DEE7",
        "edge-dim": "#CBD2DC",
        "label-bg": "#1A202C",
        "label-fg": "#FFFFFF",
        "mask": "rgba(249, 249, 251, 0.72)"
      },
      "shadow": {
        "shadow": "0 2px 4px rgba(26, 32, 44, 0.05)",
        "glow": "0 0 15px rgba(88, 27, 211, 0.3)"
      }
    },
    "dark": {
      "color": {
        "bg": "#13111A",
        "surface": "#1C1926",
        "surface-2": "#221F2E",
        "primary": "#9E74FF",
        "primary-soft": "rgba(158, 116, 255, 0.12)",
        "primary-line": "rgba(158, 116, 255, 0.3)",
        "border": "#2F2B3F",
        "text": "#ECEAF3",
        "text-2": "#BDB8CF",
        "muted": "#9A94AE",
        "faint": "#736D86",
        "chip": "#2A2638",
        "dot": "#2C2839",
        "edge-dim": "#3A3550",
        "label-bg": "#ECEAF3",
        "label-fg": "#13111A",
        "mask": "rgba(19, 17, 26, 0.72)"
      },
      "shadow": {
        "shadow": "0 2px 4px rgba(0,0,0,0.3)",
        "glow": "0 0 16px rgba(158,116,255,0.35)"
      }
    }
  },
  "descriptions": {
    "bg": "Page background",
    "surface": "Panels, cards, nodes",
    "surface-2": "Secondary surface",
    "primary": "Brand accent",
    "primary-soft": "Accent tint for hovers and highlights",
    "primary-line": "Accent outline",
    "border": "Dividers and outlines",
    "text": "Primary text",
    "text-2": "Secondary text",
    "muted": "Tertiary text",
    "faint": "Placeholder and disabled",
    "chip": "Chip background",
    "dot": "Canvas dot grid",
    "edge-dim": "Graph edges not in the selected path",
    "label-bg": "Edge label background",
    "label-fg": "Edge label text",
    "mask": "Overlay behind sheets",
    "shadow": "Card shadow",
    "glow": "Selected-node glow"
  }
}
