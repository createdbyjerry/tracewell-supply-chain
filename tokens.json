{
  "$description": "Single source of truth for Tracewell design tokens. Edit this file, then run `node scripts/build-tokens.mjs` (GitHub Actions does it for you on push). Each token becomes a CSS variable named --{prefix}-{name}.",
  "prefix": "twsc",
  "defaultTheme": "light",
  "followSystem": false,
  "$themeNotes": "defaultTheme is what visitors see before they touch the theme toggle. Set followSystem to true to use the visitor's OS light/dark setting until they pick one.",
  "shared": {
    "font": {
      "value": "\"Montserrat\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "description": "Font stack for all text"
    },
    "radius-sm": {
      "value": "8px",
      "description": "Small controls, chips, status badges"
    },
    "radius-md": {
      "value": "12px",
      "description": "Graph nodes, buttons, list rows"
    },
    "radius-lg": {
      "value": "16px",
      "description": "Cards inside panels, zoom controls, minimap"
    },
    "radius-xl": {
      "value": "28px",
      "description": "Floating containers: app bar and side panel"
    },
    "radius-pill": {
      "value": "999px",
      "description": "Pills: tabs, theme switch"
    },
    "float-gap": {
      "value": "12px",
      "description": "Space between floating containers and the screen edge"
    },
    "panel-width": {
      "value": "340px",
      "description": "Width of the side panel (node inspector) when expanded"
    }
  },
  "themes": {
    "light": {
      "color": {
        "bg": "#F9F9FB",
        "surface": "#FFFFFF",
        "surface-2": "#F7FAFC",
        "primary": "#581BD3",
        "primary-soft": "rgba(88, 27, 211, 0.08)",
        "primary-line": "rgba(88, 27, 211, 0.2)",
        "border": "#E2E8F0",
        "text": "#1A202C",
        "text-2": "#4A5568",
        "muted": "#718096",
        "faint": "#A0AEC0",
        "chip": "#EDF2F7",
        "dot": "#D9DEE7",
        "edge-dim": "#CBD2DC",
        "label-bg": "#1A202C",
        "label-fg": "#FFFFFF",
        "mask": "rgba(249, 249, 251, 0.72)"
      },
      "shadow": {
        "shadow": "0 2px 4px rgba(26, 32, 44, 0.05)",
        "glow": "0 0 15px rgba(88, 27, 211, 0.3)",
        "float": "0 18px 40px -12px rgba(26, 32, 44, 0.22), 0 4px 12px -2px rgba(26, 32, 44, 0.08)"
      }
    },
    "dark": {
      "color": {
        "bg": "#13111A",
